{% extends "_base.html.j2" %}

{% block doc_title %}Report Card · {{ data.student.name.en }}{% endblock %}

{% block page_body %}
<div class="page">
  <div class="tri-band"></div>

  <header style="padding:18px 44px 14px; display:flex; gap:16px; align-items:center; border-bottom:1.5px solid var(--blue);">
    <img src="{{ assets_dir }}/crest-512.png" alt="" style="width:78px; height:auto; flex-shrink:0;">
    <div style="flex:1;">
      <div class="display" style="font-size:23pt; color:var(--blue); line-height:1; letter-spacing:-0.015em;">Khalsa International</div>
      <div class="caps" style="font-size:9pt; color:var(--ink); margin-top:5px;">SENIOR &nbsp; SECONDARY &nbsp; SCHOOL</div>
      <div class="script" style="font-size:9.5pt; color:var(--ink-soft); margin-top:5px;">Jalalabad, District Patiala — Punjab · Aff. No. 4906 · PSEB</div>
    </div>
    <div style="text-align:right; flex-shrink:0;">
      <div style="display:inline-block; background:var(--blue); color:#fff; padding:4px 11px; border-radius:3px; font-family:'Cinzel', serif; font-size:9.5pt; letter-spacing:0.26em; font-weight:600;">REPORT CARD</div>
      <div style="font-size:9pt; color:var(--ink-soft); margin-top:6px;">Session <b style="color:var(--ink);">{{ data.session }}</b>{% if data.term %} · {{ data.term }}{% endif %}</div>
    </div>
  </header>

  {# Student meta — photo box + grid #}
  <div style="padding:14px 44px 0; display:flex; gap:16px; align-items:flex-start;">
    <div style="width:78px; height:96px; border:1px dashed #B8B09A; border-radius:5px; display:flex; align-items:center; justify-content:center; background:#FBFAF6; text-align:center; font-size:7.5pt; color:var(--ink-faint); letter-spacing:0.14em; line-height:1.3; flex-shrink:0;">
      {% if data.student.photoUrl %}
      <img src="{{ data.student.photoUrl }}" alt="" style="width:100%; height:100%; object-fit:cover; border-radius:5px;">
      {% else %}
      STUDENT<br>PHOTO
      {% endif %}
    </div>
    <div style="flex:1; display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px 18px; font-size:10pt;">
      <div>
        <div class="label">STUDENT NAME</div>
        <div style="font-weight:700; margin-top:1px;">{{ data.student.name.en }}</div>
        {% if data.student.name.pa %}<div class="gurmukhi" style="font-size:9pt; color:var(--ink-soft);">{{ data.student.name.pa }}</div>{% endif %}
      </div>
      <div>
        <div class="label">FATHER / GUARDIAN</div>
        <div style="font-weight:700; margin-top:1px;">{{ data.student.fatherName.en }}</div>
        {% if data.student.fatherName.pa %}<div class="gurmukhi" style="font-size:9pt; color:var(--ink-soft);">{{ data.student.fatherName.pa }}</div>{% endif %}
      </div>
      <div>
        <div class="label">MOTHER</div>
        <div style="font-weight:700; margin-top:1px;">{{ data.student.motherName.en }}</div>
        {% if data.student.motherName.pa %}<div class="gurmukhi" style="font-size:9pt; color:var(--ink-soft);">{{ data.student.motherName.pa }}</div>{% endif %}
      </div>
      <div>
        <div class="label">CLASS &amp; SECTION</div>
        <div style="font-weight:700; margin-top:1px;">{{ data.student.class }} — {{ data.student.section }}</div>
      </div>
      <div>
        <div class="label">ROLL NO.</div>
        <div style="font-weight:700; margin-top:1px;">{{ data.student.rollNo }}</div>
      </div>
      {% if data.student.admissionNo %}
      <div>
        <div class="label">ADMISSION NO.</div>
        <div style="font-weight:700; margin-top:1px;">{{ data.student.admissionNo }}</div>
      </div>
      {% endif %}
      <div>
        <div class="label">DATE OF BIRTH</div>
        <div style="font-weight:700; margin-top:1px;">{{ data.student.dob | dt }}</div>
      </div>
      {% if data.student.house %}
      <div>
        <div class="label">HOUSE</div>
        <div style="font-weight:700; margin-top:1px;">{{ data.student.house }}</div>
      </div>
      {% endif %}
      {% if data.signatures and data.signatures.classTeacher %}
      <div>
        <div class="label">CLASS TEACHER</div>
        <div style="font-weight:700; margin-top:1px;">{{ data.signatures.classTeacher }}</div>
      </div>
      {% endif %}
    </div>
  </div>

  {# Scholastic table #}
  <div style="padding:14px 44px 0;">
    <div class="label" style="color:var(--blue); margin-bottom:6px;">SCHOLASTIC AREAS — MARKS OBTAINED</div>
    <table style="width:100%; border-collapse:collapse; font-size:10pt;">
      <thead>
        <tr style="background:var(--blue); color:#fff; font-family:'Cinzel', serif; font-size:9pt; letter-spacing:0.14em;">
          <th style="padding:7px 8px; text-align:left;">SUBJECT</th>
          <th style="padding:7px 6px; text-align:center; width:70px;">MARKS</th>
          <th style="padding:7px 6px; text-align:center; width:60px;">MAX</th>
          <th style="padding:7px 6px; text-align:center; width:50px;">GRADE</th>
        </tr>
      </thead>
      <tbody>
        {% for sub in data.subjects %}
        <tr style="background:{% if loop.index0 % 2 %}#FBFAF6{% else %}#FFF{% endif %};">
          <td style="padding:6px 8px; border-bottom:1px solid #EEF0F3; font-weight:600;">
            {{ sub.name.en }}
            {% if sub.name.pa %}<div class="gurmukhi" style="font-size:8.5pt; color:var(--ink-soft); font-weight:400;">{{ sub.name.pa }}</div>{% endif %}
          </td>
          <td class="mono" style="padding:6px 6px; border-bottom:1px solid #EEF0F3; text-align:center; font-weight:800;">{{ sub.marks }}</td>
          <td class="mono" style="padding:6px 6px; border-bottom:1px solid #EEF0F3; text-align:center; color:var(--ink-soft);">{{ sub.max }}</td>
          <td style="padding:6px 6px; border-bottom:1px solid #EEF0F3; text-align:center; font-weight:800; color:var(--blue);">{{ sub.grade or "—" }}</td>
        </tr>
        {% endfor %}
        <tr>
          <td style="padding:9px 8px; font-family:'Playfair Display', serif; font-weight:800; color:var(--blue); border-top:2px solid var(--blue);">TOTAL</td>
          <td class="mono" style="padding:9px 6px; border-top:2px solid var(--blue); text-align:center; font-family:'Playfair Display', serif; font-weight:800; font-size:12pt;">{{ data.summary.total }}</td>
          <td class="mono" style="padding:9px 6px; border-top:2px solid var(--blue); text-align:center; color:var(--ink-soft);">{{ data.summary.max }}</td>
          <td style="padding:9px 6px; border-top:2px solid var(--blue); text-align:center; font-family:'Playfair Display', serif; font-weight:800; font-size:12pt; color:var(--blue);">{{ "%.1f"|format(data.summary.percentage) }}%</td>
        </tr>
      </tbody>
    </table>
  </div>

  {# Co-scholastic + attendance/rank tile #}
  <div style="padding:14px 44px 0; display:flex; gap:14px;">
    <div style="flex:1.4;">
      {% if data.coScholastic %}
      <div class="label" style="color:var(--blue); margin-bottom:6px;">CO-SCHOLASTIC AREAS</div>
      <table style="width:100%; border-collapse:collapse; font-size:10pt;">
        <tbody>
          {% for c in data.coScholastic %}
          <tr>
            <td style="padding:5px 8px; border-bottom:1px solid #EEF0F3;">{{ c.name }}</td>
            <td style="padding:5px 8px; border-bottom:1px solid #EEF0F3; text-align:right; font-weight:800; color:var(--blue);">{{ c.grade }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>
    <div style="flex:1; background:#FBFAF6; border:1px solid #ECE6C5; border-radius:8px; padding:12px 14px;">
      {% if data.summary.attendancePct is not none %}
      <div class="label" style="color:var(--blue);">ATTENDANCE</div>
      <div style="font-family:'Playfair Display', serif; font-weight:800; font-size:30pt; color:var(--blue); line-height:1; margin-top:4px;">{{ "%.0f"|format(data.summary.attendancePct) }}%</div>
      {% if data.summary.daysPresent and data.summary.workingDays %}
      <div style="font-size:9pt; color:var(--ink-soft);">{{ data.summary.daysPresent }} of {{ data.summary.workingDays }} working days</div>
      {% endif %}
      <div style="height:1px; background:#ECE6C5; margin:10px 0;"></div>
      {% endif %}
      {% if data.summary.rank %}
      <div class="label" style="color:var(--blue);">RANK · CLASS {{ data.student.class }}-{{ data.student.section }}</div>
      <div style="font-family:'Playfair Display', serif; font-weight:800; font-size:20pt; color:var(--ink); line-height:1; margin-top:4px;">
        {{ data.summary.rank }}<span style="font-size:11pt; color:var(--ink-soft);">{% if data.summary.rank == 1 %}st{% elif data.summary.rank == 2 %}nd{% elif data.summary.rank == 3 %}rd{% else %}th{% endif %}</span>
        {% if data.summary.classSize %}<span style="font-size:10pt; color:var(--ink-soft);"> of {{ data.summary.classSize }}</span>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>

  {# Remarks + grading scale #}
  <div style="padding:14px 44px 0; display:flex; gap:14px;">
    <div style="flex:1.5;">
      <div class="label" style="color:var(--blue); margin-bottom:4px;">CLASS TEACHER'S REMARK</div>
      <div class="script" style="font-size:11pt; line-height:1.5; color:var(--ink); border-left:3px solid var(--gold); padding-left:10px;">
        {% if data.summary.remarks %}
        {{ data.summary.remarks.en }}
        {% if data.summary.remarks.pa %}
        <div class="gurmukhi" style="font-style:normal; font-size:9.5pt; color:var(--ink-soft); margin-top:4px;">{{ data.summary.remarks.pa }}</div>
        {% endif %}
        {% else %}
        Excellent term, keep it up.
        {% endif %}
      </div>
    </div>
    <div style="flex:1;">
      <div class="label" style="color:var(--blue); margin-bottom:4px;">GRADING SCALE</div>
      <div style="font-size:8.5pt; line-height:1.55; color:var(--ink-soft); column-count:2; column-gap:14px;">
        A1 &nbsp;91–100<br>A2 &nbsp;81–90<br>B1 &nbsp;71–80<br>B2 &nbsp;61–70<br>C1 &nbsp;51–60<br>C2 &nbsp;41–50<br>D &nbsp;&nbsp;below 41
      </div>
    </div>
  </div>

  {# Sign-off row #}
  <div style="padding:28px 44px 0; display:flex; justify-content:space-between;">
    {% set sigs = [
      ('Class Teacher', data.signatures.classTeacher if data.signatures else None),
      ('Examination In-charge', data.signatures.examIncharge if data.signatures else None),
      ('Principal', data.signatures.principal if data.signatures else None),
      ('Parent / Guardian', None),
    ] %}
    {% for label, name in sigs %}
    <div style="text-align:center; min-width:130px;">
      <div class="script" style="font-size:14pt; height:18px;">{% if label == 'Principal' and name %}{{ name }}{% endif %}</div>
      <div style="border-top:1px solid var(--ink); margin-top:6px; padding-top:4px; font-size:9pt;">
        <b>{{ label }}</b>
        {% if name and label != 'Principal' %}<br><span style="color:var(--ink-soft); font-weight:400;">{{ name }}</span>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>

  <img class="watermark" src="{{ assets_dir }}/crest-512.png" alt="">

  <footer class="brand-footer">
    <span>VIDYA · VICHAR · SEVA</span>
    <span class="gold">EST. 2005</span>
    <span>{{ data.summary.promotion or "" }}</span>
  </footer>
</div>
{% endblock %}

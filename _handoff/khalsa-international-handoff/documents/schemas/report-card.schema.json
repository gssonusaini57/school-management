{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "report-card",
  "title": "Annual Report Card",
  "type": "object",
  "required": [
    "session",
    "student",
    "subjects",
    "summary"
  ],
  "properties": {
    "session": {
      "type": "string",
      "pattern": "^\\\\d{4}-\\\\d{2}$"
    },
    "student": {
      "type": "object",
      "required": [
        "name",
        "class",
        "section",
        "rollNo",
        "fatherName",
        "motherName",
        "dob",
        "house"
      ],
      "properties": {
        "name": {
          "type": "object",
          "required": [
            "en",
            "pa"
          ],
          "properties": {
            "en": {
              "type": "string"
            },
            "pa": {
              "type": "string"
            }
          }
        },
        "class": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "rollNo": {
          "type": "string"
        },
        "fatherName": {
          "type": "object",
          "required": [
            "en",
            "pa"
          ],
          "properties": {
            "en": {
              "type": "string"
            },
            "pa": {
              "type": "string"
            }
          }
        },
        "motherName": {
          "type": "object",
          "required": [
            "en",
            "pa"
          ],
          "properties": {
            "en": {
              "type": "string"
            },
            "pa": {
              "type": "string"
            }
          }
        },
        "dob": {
          "type": "string",
          "format": "date"
        },
        "house": {
          "enum": [
            "Ravidas",
            "Tagore",
            "Bhagat Singh",
            "Nanak"
          ]
        },
        "photoUrl": {
          "type": "string"
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "marks",
          "max"
        ],
        "properties": {
          "name": {
            "type": "object",
            "required": [
              "en",
              "pa"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "pa": {
                "type": "string"
              }
            }
          },
          "marks": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "grade": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "max",
        "percentage",
        "rank",
        "attendancePct",
        "promotion"
      ],
      "properties": {
        "total": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "percentage": {
          "type": "number"
        },
        "rank": {
          "type": "integer"
        },
        "attendancePct": {
          "type": "number"
        },
        "remarks": {
          "type": "object",
          "required": [
            "en",
            "pa"
          ],
          "properties": {
            "en": {
              "type": "string"
            },
            "pa": {
              "type": "string"
            }
          }
        },
        "promotion": {
          "enum": [
            "Promoted",
            "Detained",
            "Conditional"
          ]
        }
      }
    },
    "signatures": {
      "type": "object",
      "properties": {
        "classTeacher": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        }
      }
    }
  }
}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "jq -r '.tool_input.command // empty' | sh \"${CLAUDE_PROJECT_DIR:-.}/.githooks/no-ai-attribution.sh\" loose || exit 2",
            "statusMessage": "Checking for AI attribution trailers",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "jq -r '.tool_input.command // empty' | sh \"${CLAUDE_PROJECT_DIR:-.}/.githooks/no-ai-attribution.sh\" loose || exit 2",
            "statusMessage": "Checking for AI attribution trailers",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

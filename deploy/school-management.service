[Unit]
Description=KIS School Management FastAPI
After=network.target mysql.service

[Service]
User=school
Group=school
WorkingDirectory=/opt/school-management/app
EnvironmentFile=/opt/school-management/.env
ExecStart=/opt/school-management/app/.venv/bin/gunicorn app.main:app \
          -k uvicorn.workers.UvicornWorker -w 2 -b 127.0.0.1:8000 \
          --timeout 120 \
          --access-logfile /opt/school-management/logs/access.log \
          --error-logfile /opt/school-management/logs/error.log
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/school-management/logs/stdout.log
StandardError=append:/opt/school-management/logs/stderr.log

[Install]
WantedBy=multi-user.target

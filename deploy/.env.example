DATABASE_URL=mysql+pymysql://school:CHANGE_ME@localhost:3306/school_management
JWT_SECRET=CHANGE_ME_run_python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_EXPIRY_HOURS=1
ADMIN_DEFAULT_PASSWORD=admin123
CORS_ORIGINS=https://expressonly.in
LOG_DIR=/opt/school-management/logs
BACKUP_DIR=/opt/school-management/backups

# --- Outbound email (Zoho Mail) for the forgot-password flow ---
# Mailbox: info@kisschool.in (created in the Zoho portal).
# India datacenter → smtp.zoho.in ; global → smtp.zoho.com. Port 465 = SSL.
# SMTP_PASSWORD must be a Zoho APP PASSWORD (Zoho → My Account → Security →
# App Passwords) when 2FA is enabled — NOT the normal mailbox login password.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=info@kisschool.in
SMTP_PASSWORD=CHANGE_ME_zoho_app_password
SMTP_USE_SSL=true
SMTP_FROM=info@kisschool.in
SMTP_FROM_NAME=Khalsa International School

# Base URL of the admin SPA (no trailing slash). Reset links point at
# <APP_BASE_URL>/reset-password?token=...
# TEST: https://expressonly.in/school/admin   PROD: https://kisschool.in
APP_BASE_URL=https://expressonly.in/school/admin
RESET_TOKEN_TTL_MINUTES=30

# --- Outbound email (Zoho Mail) — powers the forgot-password flow ---
# Zoho India datacenter: smtp.zoho.in (port 465 SSL). Global: smtp.zoho.com.
# SMTP_USER is the full mailbox address; SMTP_PASSWORD must be a Zoho *app password*
# (Zoho → My Account → Security → App Passwords) when 2FA is enabled on the mailbox.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=info@kisschool.in
SMTP_PASSWORD=CHANGE_ME_zoho_app_password
SMTP_USE_SSL=true
SMTP_FROM=info@kisschool.in
SMTP_FROM_NAME=Khalsa International School
# Base URL of the admin SPA (no trailing slash) — used to build reset links.
# TEST: https://expressonly.in/school/admin   PROD: https://kisschool.in/admin
APP_BASE_URL=https://expressonly.in/school/admin
RESET_TOKEN_TTL_MINUTES=30

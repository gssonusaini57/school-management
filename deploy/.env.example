# Template for <APP_ROOT>/.env — normally written by scripts/provision/04-write-env.sh
# (secrets are generated on the server). Values below show both instances on
# 69.62.72.137: PROD at /opt/school-management, TEST at /opt/school-management-test.

DATABASE_URL=mysql+pymysql://school:CHANGE_ME@localhost:3306/school_management
#   TEST: mysql+pymysql://school_test:CHANGE_ME@localhost:3306/school_management_test
JWT_SECRET=CHANGE_ME_run_python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_EXPIRY_HOURS=1
ADMIN_DEFAULT_PASSWORD=admin123
CORS_ORIGINS=https://kisschool.in
#   TEST: http://69.62.72.137
LOG_DIR=/opt/school-management/logs
BACKUP_DIR=/opt/school-management/backups

# Base URL of the admin SPA (no trailing slash) — reset links point at
# <APP_BASE_URL>/reset-password?token=... and notification emails link here.
APP_BASE_URL=https://kisschool.in/admin
#   TEST: http://69.62.72.137/kisschool/admin
RESET_TOKEN_TTL_MINUTES=30

# --- Outbound email (Zoho Mail) — PROD ONLY -------------------------------
# TEST leaves every SMTP_* key out on purpose: its DB is a clone of prod, so it
# holds real staff addresses. Email is enabled only when SMTP_HOST, SMTP_USER and
# SMTP_PASSWORD are all set.
# Zoho India datacenter: smtp.zoho.in (port 465 SSL). Global: smtp.zoho.com.
# SMTP_PASSWORD must be a Zoho *app password* (Zoho → My Account → Security →
# App Passwords) when 2FA is enabled on the mailbox.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=info@kisschool.in
SMTP_PASSWORD=CHANGE_ME_zoho_app_password
SMTP_USE_SSL=true
SMTP_FROM=info@kisschool.in
SMTP_FROM_NAME="Khalsa International School"
APPROVER_NOTIFY_EMAIL=info@kisschool.in

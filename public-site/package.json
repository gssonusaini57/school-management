{
  "name": "kis-public-site",
  "private": true,
  "version": "1.0.0",
  "description": "KIS Khalsa International public marketing site (static HTML, deployed to nginx).",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/css/site.css -o dist/css/site.css --minify",
    "build:html": "eleventy",
    "build": "npm run build:css && npm run build:html",
    "dev:css": "tailwindcss -c tailwind.config.cjs -i src/css/site.css -o dist/css/site.css --watch",
    "dev:html": "eleventy --serve --port 8080",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.17"
  }
}
